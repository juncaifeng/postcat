{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev",
      "type": "shell",
      "command": "yarn start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling...",
          "endsPattern": "Compiled successfully."
        }
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Build (No Sign)",
      "type": "shell",
      "command": "yarn build:win:noSign",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Production (With Sign)",
      "type": "shell",
      "command": "yarn build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start Web Only",
      "type": "shell",
      "command": "yarn start:web",
      "isBackground": true,
      "group": "test"
    },
    {
      "label": "Start Electron Only",
      "type": "shell",
      "command": "yarn start:electron",
      "isBackground": true,
      "group": "test"
    }
  ]
}
